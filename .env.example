# Runtime profile: personal | team | enterprise
PROFILE=personal

# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Database (local E0 default: SQLite; compose uses Postgres)
DATABASE_URL=sqlite:///./data/kb.db

# Redis (optional in E0; leave empty to skip ready check)
REDIS_URL=

# Qdrant (optional in E0)
QDRANT_URL=

# Object storage (optional in E0)
S3_ENDPOINT=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kb-documents
S3_REGION=us-east-1

# Auth
JWT_SECRET=dev-change-me-e0
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
LOCAL_STORAGE_DIR=./data/objects

# Extra CORS origins for remote browser access (comma-separated)
# CORS_ORIGINS=http://YOUR_IP:3000
CORS_ORIGINS=
CORS_ORIGIN_REGEX=https://.*\.trycloudflare\.com
