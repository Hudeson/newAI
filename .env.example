# Hugging Face access token (read is enough for inference + model info)
# Create at: https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional Hub API mirror (common in mainland China)
# HF_ENDPOINT=https://hf-mirror.com

# Defaults used by the CLI / HuggingFaceClient
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_PROVIDER=auto
# Use HF_PROVIDER=local with a small model (e.g. sshleifer/tiny-gpt2) to run offline via transformers
HF_TIMEOUT=60
# Token needs Inference Providers permission:
# https://huggingface.co/settings/tokens
